# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Test cache
.pytest_cache/

# C extensions
*.so

# Distribution / packaging
bin/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
.venv/
venv/
ENV/
env/
.env

# Streamlit config and cache logs
.streamlit/
.streamlit/config.toml

# IDEs
.vscode/
.idea/
*.swp

# DVC and Local Data cache (exclude heavy dataset tracking inside Git)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/artifacts/*
!data/artifacts/.gitkeep
models/*
!models/.gitkeep
# .dvc/config stays tracked so the remote is shared; the local override isn't.
.dvc/config.local
.dvc/tmp/
.dvc/cache/

# MLflow local tracking store (SQLite backend, MLflow 3.x default)
mlflow.db
mlruns/
mlartifacts/
